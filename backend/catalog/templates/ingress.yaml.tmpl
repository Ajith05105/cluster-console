# TEMPLATE. The Traefik route: requests arriving at Traefik for the route's
# host name are passed to the workload's Service.
#
# The name and host are the same whichever catalog image is deployed, so the
# load generator always sends to the same place.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: workload
  namespace: {{.Namespace}}
  labels:
    app: {{.Key}}
    managed-by: console
spec:
  ingressClassName: traefik
  rules:
    - host: {{.Host}}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{.Key}}
                port:
                  name: http
