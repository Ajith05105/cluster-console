{
  "default": "camera-ingest",
  "node_death_seconds": { "baseline": 300, "fast": 20 },
  "excluded_nodes": ["mac-mini-agent"],
  "items": [
    {
      "key": "camera-ingest",
      "name": "Camera ingest (default)",
      "image": "gitea.cluster.local:3000/apps/camera-ingest:0.1.0",
      "upstream": null,
      "port": 8080,
      "health_path": "/ready",
      "liveness_path": "/healthz",
      "load": { "method": "POST", "path": "/frame" },
      "env": { "WORK_MS": "40", "MAX_INFLIGHT": "8" },
      "cpu_request": "500m",
      "cpu_limit": "1",
      "memory_request": "128Mi",
      "memory_limit": "256Mi",
      "locked_down": true,
      "hpa": { "target_cpu_percent": 50, "min_replicas": 1, "max_replicas": 20 }
    },
    {
      "key": "nginx-alpine",
      "name": "nginx (alpine)",
      "image": "gitea.cluster.local:3000/apps/nginx:1.31.6-alpine",
      "upstream": "docker.io/library/nginx:1.31.6-alpine",
      "port": 80,
      "health_path": "/",
      "liveness_path": "/",
      "load": { "method": "GET", "path": "/" },
      "env": {},
      "cpu_request": "100m",
      "cpu_limit": null,
      "memory_request": "32Mi",
      "memory_limit": "128Mi",
      "locked_down": false,
      "hpa": { "target_cpu_percent": 50, "min_replicas": 1, "max_replicas": 20 }
    },
    {
      "key": "httpd-alpine",
      "name": "Apache httpd (alpine)",
      "image": "gitea.cluster.local:3000/apps/httpd:2.4.69-alpine",
      "upstream": "docker.io/library/httpd:2.4.69-alpine",
      "port": 80,
      "health_path": "/",
      "liveness_path": "/",
      "load": { "method": "GET", "path": "/" },
      "env": {},
      "cpu_request": "100m",
      "cpu_limit": null,
      "memory_request": "32Mi",
      "memory_limit": "128Mi",
      "locked_down": false,
      "hpa": { "target_cpu_percent": 50, "min_replicas": 1, "max_replicas": 20 }
    },
    {
      "key": "caddy",
      "name": "Caddy",
      "image": "gitea.cluster.local:3000/apps/caddy:2.11.7-alpine",
      "upstream": "docker.io/library/caddy:2.11.7-alpine",
      "port": 80,
      "health_path": "/",
      "liveness_path": "/",
      "load": { "method": "GET", "path": "/" },
      "env": {},
      "cpu_request": "100m",
      "cpu_limit": null,
      "memory_request": "32Mi",
      "memory_limit": "128Mi",
      "locked_down": false,
      "hpa": { "target_cpu_percent": 50, "min_replicas": 1, "max_replicas": 20 }
    },
    {
      "key": "whoami",
      "name": "traefik/whoami",
      "image": "gitea.cluster.local:3000/apps/whoami:v1.12.0",
      "upstream": "docker.io/traefik/whoami:v1.12.0",
      "port": 80,
      "health_path": "/health",
      "liveness_path": "/health",
      "load": { "method": "GET", "path": "/" },
      "env": {},
      "cpu_request": "50m",
      "cpu_limit": null,
      "memory_request": "16Mi",
      "memory_limit": "64Mi",
      "locked_down": false,
      "hpa": { "target_cpu_percent": 50, "min_replicas": 1, "max_replicas": 20 }
    }
  ]
}
